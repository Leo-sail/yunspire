{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunspire.local/schemas/brand-profile.schema.json",
  "title": "BrandProfile",
  "description": "Versioned brand voice and publishing constraints used by the writing and design runtimes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "status",
    "voice",
    "vocabulary",
    "style",
    "claimsPolicy",
    "purposeDefaults",
    "signature",
    "examples",
    "provenance",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": ["string", "null"], "maxLength": 1000 },
    "status": { "type": "string", "enum": ["draft", "active", "archived"] },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presetId", "traits", "prohibitedTraits"],
      "properties": {
        "presetId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,79}$" },
        "traits": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "uniqueItems": true },
        "prohibitedTraits": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "uniqueItems": true }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "avoided", "requiredTerms"],
      "properties": {
        "preferred": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/termRule" } },
        "avoided": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/termRule" } },
        "requiredTerms": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formality", "perspective", "sentenceLength", "emoji", "punctuation", "callToAction"],
      "properties": {
        "formality": { "type": "string", "enum": ["casual", "balanced", "formal"] },
        "perspective": { "type": "string", "enum": ["firstPerson", "secondPerson", "thirdPerson", "mixed"] },
        "sentenceLength": { "type": "string", "enum": ["short", "varied", "long"] },
        "emoji": { "type": "string", "enum": ["none", "restrained", "allowed"] },
        "punctuation": { "type": "string", "enum": ["standardCjk", "expressive", "minimal"] },
        "callToAction": { "type": "string", "enum": ["none", "soft", "direct"] }
      }
    },
    "claimsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireSources", "labelInference", "forbidFabrication", "sensitiveTopics"],
      "properties": {
        "requireSources": { "type": "boolean" },
        "labelInference": { "type": "boolean" },
        "forbidFabrication": { "const": true },
        "sensitiveTopics": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true }
      }
    },
    "purposeDefaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["presetId"],
        "properties": {
          "presetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
          "notes": { "type": ["string", "null"], "maxLength": 500 }
        }
      },
      "maxProperties": 20
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "author", "byline", "footer"],
      "properties": {
        "enabled": { "type": "boolean" },
        "author": { "type": ["string", "null"], "maxLength": 120 },
        "byline": { "type": ["string", "null"], "maxLength": 500 },
        "footer": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "content", "approved"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "approved": { "type": "boolean" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "source", "userApproved"],
      "properties": {
        "createdBy": { "type": "string", "enum": ["user", "assistant", "import"] },
        "source": { "type": "string", "enum": ["manual", "conversation", "file", "derivedFromExamples"] },
        "sourceRef": { "type": ["string", "null"], "maxLength": 2048 },
        "userApproved": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "termRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term"],
      "properties": {
        "term": { "type": "string", "minLength": 1, "maxLength": 120 },
        "replacement": { "type": ["string", "null"], "maxLength": 120 },
        "note": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
