{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunspire.local/schemas/memory-reflection-job.schema.json",
  "title": "MemoryReflectionJob",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "idempotencyKey", "scope", "sourceDocIds", "sourceContentHash", "metrics", "state", "attemptCount", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "taskId": { "type": ["string", "null"], "maxLength": 160 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "agentId", "appId", "projectId", "sessionId"],
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "agentId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "appId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "sourceDocIds": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "sourceContentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "metrics": { "type": "object", "additionalProperties": true },
    "state": { "type": "string", "enum": ["queued", "running", "awaiting_review", "completed", "failed", "cancelled"] },
    "proposalMemoryId": { "type": ["string", "null"], "maxLength": 160 },
    "attemptCount": { "type": "integer", "minimum": 0 },
    "lastError": { "type": ["string", "null"], "maxLength": 2000 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
