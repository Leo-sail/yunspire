{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunspire.local/schemas/schedule.schema.json",
  "title": "UserScheduleRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "name", "enabled", "timezone", "trigger", "job", "policies", "limits", "created_by", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "enabled": { "type": "boolean" },
    "timezone": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string", "enum": ["user", "secretary", "evolution"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "expression"],
          "properties": {
            "type": { "const": "cron" },
            "expression": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "seconds"],
          "properties": {
            "type": { "const": "interval" },
            "seconds": { "type": "integer", "minimum": 60 }
          }
        }
      ]
    },
    "job": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sources", "pipeline", "destination"],
          "properties": {
            "kind": { "const": "collection" },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "type": "string", "enum": ["url", "feed", "file", "folder", "source_adapter", "saved_query"] },
                  "value": { "type": "string", "minLength": 1 },
                  "credential_ref": { "type": ["string", "null"] }
                }
              }
            },
            "pipeline": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["extract", "normalize", "deduplicate", "classify", "summarize", "atomize", "organize_properties", "repair_links", "review", "commit"] }
            },
            "destination": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "report_subscription_id"],
          "properties": {
            "kind": { "const": "report" },
            "report_subscription_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request", "requested_skills"],
          "properties": {
            "kind": { "const": "secretary_task" },
            "request": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "User-authored task data; never interpreted as system policy." },
            "requested_skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "context_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      ]
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missed_run", "overlap", "failure", "approval"],
      "properties": {
        "missed_run": { "type": "string", "enum": ["skip", "run_once_on_wake", "run_all_bounded"] },
        "overlap": { "type": "string", "enum": ["skip", "queue", "cancel_previous"] },
        "failure": { "type": "string", "enum": ["quarantine", "retry_then_quarantine", "pause_schedule"] },
        "approval": { "type": "string", "enum": ["policy", "always_review", "auto_commit_within_scope"] }
      }
    },
    "delivery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["destination_type", "destination_ref"],
        "properties": {
          "destination_type": { "type": "string", "enum": ["local_notification", "report_center", "approved_channel"] },
          "destination_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "max_runtime_minutes", "max_tool_calls"],
      "properties": {
        "max_items": { "type": "integer", "minimum": 1 },
        "max_runtime_minutes": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "max_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
