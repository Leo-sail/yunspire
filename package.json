{
  "name": "yunspire-desktop",
  "version": "0.3.0",
  "description": "云枢：以 Obsidian 为知识底座的本地自成长个人知识中枢",
  "author": "Leo Chang <leochang210@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "https://github.com/Leo-sail/yunspire.git",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens:build": "style-dictionary build --config desktop-ui/style-dictionary.config.mjs",
    "storybook": "npm run tokens:build && storybook dev -p 6006",
    "storybook:build": "npm run tokens:build && storybook build",
    "build": "npm run tokens:build && node scripts/generate-third-party-notices.mjs && node scripts/build-windows-python-runtime.mjs && node scripts/build-windows-native.mjs && node scripts/build-windows-media-helper.mjs && vite build",
    "build:third-party-notices": "node scripts/generate-third-party-notices.mjs",
    "build:macos-python-runtime": "node scripts/build-macos-python-runtime.mjs",
    "build:windows-python-runtime": "node scripts/build-windows-python-runtime.mjs",
    "build:windows-media-helper": "node scripts/build-windows-media-helper.mjs",
    "generate:creation-resources": "node scripts/generate-creation-resources.mjs",
    "native:check": "node scripts/run-native-quality.mjs check",
    "native:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "native:clippy": "node scripts/run-native-quality.mjs clippy",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:first-party-skills": "node scripts/validate-first-party-skills.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "verify:release-version-contract": "node --test --test-concurrency=1 scripts/verify-release-version-contract.mjs",
    "quality:gates": "node scripts/quality-gates.mjs",
    "verify": "npm run audit:release && npm run verify:release-version-contract && npm run validate:schemas && npm run validate:first-party-skills && npm run build && npm run quality:gates && npm run native:fmt:check && npm run native:clippy",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug --bundles app --no-sign --ci",
    "tauri:build:windows:unsigned": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.release.conf.json --no-sign --ci"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.0.0",
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.6",
    "@tauri-apps/cli": "^2.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.27.2",
    "storybook": "^10.5.6",
    "style-dictionary": "^5.5.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
