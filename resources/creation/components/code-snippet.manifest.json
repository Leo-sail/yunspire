{
  "schemaVersion": "1.0",
  "manifestType": "component",
  "catalogVersion": "0.4.0",
  "id": "code-snippet",
  "version": "1.0.0",
  "displayName": "代码片段",
  "description": "展示与文章论点直接相关的短代码，并说明输入、输出和安全边界。",
  "status": "active",
  "category": "information",
  "legacyIds": [],
  "blockKind": "leaf",
  "slots": [
    {
      "id": "body",
      "kind": "richText",
      "required": true,
      "maxLength": 4000
    }
  ],
  "semantics": {
    "role": "note",
    "ariaLabel": "代码片段",
    "markdownFallback": "paragraphs"
  },
  "constraints": {
    "minItems": 1,
    "maxItems": 1,
    "allowNestedComponents": false,
    "spanLeaf": true,
    "allowScripts": false,
    "allowExternalStyles": false
  },
  "templateMarkdown": "### 代码片段\n\n**最小代码：** [填写基于本地知识库的内容]\n\n**输入与输出：** [填写基于本地知识库的内容]\n\n**安全边界：** [填写基于本地知识库的内容]\n\n**来源：** [[替换为实际笔记标题]]",
  "renderers": {
    "markdown": "creation.component.code-snippet.markdown.v1",
    "html": "creation.component.code-snippet.html.v1",
    "wechatRichText": "creation.component.code-snippet.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
    "minRuntimeVersion": "0.1.2"
  },
  "source": {
    "policy": "yunspire_first_party",
    "authoredBy": "Yunspire",
    "repository": "https://github.com/Leo-sail/yunspire",
    "upstreamCodeCopied": false,
    "researchBoundary": "This component is an original Yunspire project asset. External repositories informed capability research only; no upstream code, prompt, template, wording, or visual asset is included."
  },
  "license": {
    "scope": "yunspire_first_party_project_asset",
    "notice": "Original Yunspire component manifest and Markdown block; use is governed by the repository LICENSE.",
    "thirdPartyAssets": []
  }
}
