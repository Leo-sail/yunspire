{
  "schemaVersion": "1.0",
  "manifestType": "component",
  "catalogVersion": "0.4.0",
  "id": "cover-card",
  "version": "1.0.0",
  "displayName": "封面卡",
  "description": "为文章、报告或社交内容提供标题、副标题和视觉焦点文案。",
  "status": "active",
  "category": "media",
  "legacyIds": [],
  "blockKind": "media",
  "slots": [
    {
      "id": "body",
      "kind": "image",
      "required": true,
      "maxLength": 4000
    }
  ],
  "semantics": {
    "role": "figure",
    "ariaLabel": "封面卡",
    "markdownFallback": "figure"
  },
  "constraints": {
    "minItems": 1,
    "maxItems": 1,
    "allowNestedComponents": false,
    "spanLeaf": true,
    "allowScripts": false,
    "allowExternalStyles": false
  },
  "templateMarkdown": "### 封面卡\n\n![替换为实际图片](assets/replace-me.png)\n\n**主标题：** [填写说明]\n\n**副标题：** [填写说明]\n\n**封面说明：** [填写说明]\n\n**来源与授权：** [[替换为实际笔记标题]]",
  "renderers": {
    "markdown": "creation.component.cover-card.markdown.v1",
    "html": "creation.component.cover-card.html.v1",
    "wechatRichText": "creation.component.cover-card.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
    "minRuntimeVersion": "0.1.2"
  },
  "source": {
    "policy": "yunspire_first_party",
    "authoredBy": "Yunspire",
    "repository": "https://github.com/Leo-sail/yunspire",
    "upstreamCodeCopied": false,
    "researchBoundary": "This component is an original Yunspire project asset. External repositories informed capability research only; no upstream code, prompt, template, wording, or visual asset is included."
  },
  "license": {
    "scope": "yunspire_first_party_project_asset",
    "notice": "Original Yunspire component manifest and Markdown block; use is governed by the repository LICENSE.",
    "thirdPartyAssets": []
  }
}
