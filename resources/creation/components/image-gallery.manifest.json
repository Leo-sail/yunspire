{
  "schemaVersion": "1.0",
  "manifestType": "component",
  "catalogVersion": "0.4.0",
  "id": "image-gallery",
  "version": "1.0.0",
  "displayName": "图片画廊",
  "description": "以统一说明格式组织多张图片、截图或作品卡片。",
  "status": "active",
  "category": "media",
  "legacyIds": [],
  "blockKind": "collection",
  "slots": [
    {
      "id": "items",
      "kind": "list",
      "required": true,
      "maxLength": 10000
    }
  ],
  "semantics": {
    "role": "figure",
    "ariaLabel": "图片画廊",
    "markdownFallback": "figure"
  },
  "constraints": {
    "minItems": 1,
    "maxItems": 24,
    "allowNestedComponents": false,
    "spanLeaf": true,
    "allowScripts": false,
    "allowExternalStyles": false
  },
  "templateMarkdown": "### 图片画廊\n\n![替换为实际图片](assets/replace-me.png)\n\n**第一张图片：** [填写说明]\n\n**第二张图片：** [填写说明]\n\n**图片关系：** [填写说明]\n\n**来源与授权：** [[替换为实际笔记标题]]",
  "renderers": {
    "markdown": "creation.component.image-gallery.markdown.v1",
    "html": "creation.component.image-gallery.html.v1",
    "wechatRichText": "creation.component.image-gallery.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
    "minRuntimeVersion": "0.1.2"
  },
  "source": {
    "policy": "yunspire_first_party",
