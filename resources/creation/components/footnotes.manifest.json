{
  "schemaVersion": "1.0",
  "manifestType": "component",
  "catalogVersion": "0.4.0",
  "id": "footnotes",
  "version": "1.0.0",
  "displayName": "脚注集",
  "description": "集中维护外部链接、术语补充和引用说明，保持正文清爽。",
  "status": "active",
  "category": "navigation",
  "legacyIds": [],
  "blockKind": "collection",
  "slots": [
    {
      "id": "items",
      "kind": "list",
      "required": true,
      "maxLength": 10000
    }
  ],
  "semantics": {
    "role": "note",
    "ariaLabel": "脚注集",
    "markdownFallback": "paragraphs"
  },
  "constraints": {
    "minItems": 1,
    "maxItems": 100,
    "allowNestedComponents": false,
    "spanLeaf": true,
    "allowScripts": false,
    "allowExternalStyles": false
  },
  "templateMarkdown": "### 脚注集\n\n**本地笔记：** [填写基于本地知识库的内容]\n\n**外部链接：** [填写基于本地知识库的内容]\n\n**术语补充：** [填写基于本地知识库的内容]\n\n**来源：** [[替换为实际笔记标题]]",
  "renderers": {
    "markdown": "creation.component.footnotes.markdown.v1",
    "html": "creation.component.footnotes.html.v1",
    "wechatRichText": "creation.component.footnotes.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
    "minRuntimeVersion": "0.1.2"
  },
  "source": {
    "policy": "yunspire_first_party",
    "authoredBy": "Yunspire",
    "repository": "https://github.com/Leo-sail/yunspire",
