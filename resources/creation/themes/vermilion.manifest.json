{
  "schemaVersion": "1.0",
  "manifestType": "theme",
  "catalogVersion": "0.4.0",
  "id": "vermilion",
  "version": "1.1.0",
  "displayName": "朱简主题",
  "description": "为观点评论提供明确朱红强调和稳重正文对比的兼容主题。",
  "status": "active",
  "category": "commentary",
  "tags": [
    "观点",
    "评论",
    "朱红"
  ],
  "legacyIds": [],
  "palette": {
    "accent": "#b42318",
    "accentSoft": "#fff1ee",
    "text": "#352724",
    "muted": "#786a66",
    "border": "#eadbd7",
    "quote": "#fff7f5",
    "heading": "#631d17",
    "background": "#ffffff"
  },
  "typography": {
    "defaultFamily": "sans",
    "fallbackStack": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
    "baseSize": 16,
    "lineHeight": 1.8,
    "headingWeight": 700,
    "bodyWeight": 400
  },
  "spacing": {
    "paragraph": 16,
    "section": 32,
    "pageX": 18,
    "pageY": 24
  },
  "features": {
    "autoNumbering": false,
    "keywordUnderline": false,
    "tableOfContents": false,
    "introduction": false,
    "signature": false,
    "spanLeaf": true,
    "cjkSpacing": false,
    "externalLinkFootnotes": false
  },
  "supportedComponentIds": [
    "lead",
    "quote",
    "notice",
    "steps",
    "metrics",
    "compare",
    "dialogue",
    "timeline",
    "divider",
    "cta",
    "outline",
    "abstract",
    "key-points",
    "contents",
    "introduction",
    "conclusion",
    "section-summary",
    "executive-summary",
    "premise",
    "definition",
    "context",
    "evidence",
    "source-note",
    "fact-check",
    "warning",
    "tip",
    "example",
    "case-study",
    "faq",
    "checklist",
    "decision-matrix",
    "pros-cons",
    "before-after",
    "process",
    "milestone",
    "schedule",
    "roadmap",
    "chronology",
    "interview",
    "debate",
    "testimonial",
    "figure",
    "image-gallery",
    "cover-card",
    "infographic",
    "video-card",
    "data-table",
    "formula",
    "code-snippet",
    "footnotes",
    "author-signature",
    "related-reading",
    "next-steps"
  ],
  "renderers": {
    "markdown": "creation.theme.vermilion.markdown.v1",
    "html": "creation.theme.vermilion.html.v1",
    "wechatRichText": "creation.theme.vermilion.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
    "wechatCertification": "legacyCompatible",
    "minRuntimeVersion": "0.1.2"
  },
  "source": {
    "policy": "yunspire_first_party",
    "authoredBy": "Yunspire",
    "repository": "https://github.com/Leo-sail/yunspire",
    "upstreamCodeCopied": false,
    "researchBoundary": "Migrated from the existing Yunspire creation renderer and expanded only with original first-party metadata. External repositories informed capability research only."
  },
  "license": {
    "scope": "yunspire_first_party_project_asset",
    "notice": "Original Yunspire theme manifest and rendering tokens; use is governed by the repository LICENSE.",
    "thirdPartyAssets": []
  }
}
