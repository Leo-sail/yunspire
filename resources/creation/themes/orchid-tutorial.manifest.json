  "renderers": {
    "markdown": "creation.theme.orchid-tutorial.markdown.v1",
    "html": "creation.theme.orchid-tutorial.html.v1",
    "wechatRichText": "creation.theme.orchid-tutorial.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
