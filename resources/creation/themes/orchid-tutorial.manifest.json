{
  "schemaVersion": "1.0",
  "manifestType": "theme",
  "catalogVersion": "0.4.0",
  "id": "orchid-tutorial",
  "version": "1.0.0",
  "displayName": "兰笺·教程",
  "description": "面向步骤教学、操作清单和知识拆解，以雅致兰紫建立清晰层级、稳定阅读节奏和可复用的原创排版规则。",
  "status": "active",
  "category": "tutorial",
  "tags": [
    "教程",
    "雅致兰紫",
    "多端候选"
  ],
  "legacyIds": [],
  "palette": {
    "accent": "#745098",
    "accentSoft": "#eeeaf3",
    "text": "#312a38",
    "muted": "#88838c",
    "border": "#e3dcea",
    "quote": "#f5f3f8",
    "heading": "#402858",
    "background": "#fcfbfc"
  },
  "typography": {
    "defaultFamily": "sans",
    "fallbackStack": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
    "baseSize": 16,
    "lineHeight": 1.82,
    "headingWeight": 700,
    "bodyWeight": 400
  },
  "spacing": {
    "paragraph": 16,
    "section": 32,
    "pageX": 20,
    "pageY": 24
  },
  "features": {
    "autoNumbering": true,
    "keywordUnderline": true,
    "tableOfContents": true,
    "introduction": false,
    "signature": false,
    "spanLeaf": true,
    "cjkSpacing": true,
    "externalLinkFootnotes": false
  },
  "supportedComponentIds": [
    "lead",
    "quote",
    "notice",
    "steps",
    "metrics",
    "compare",
    "dialogue",
    "timeline",
    "divider",
