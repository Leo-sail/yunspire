{
  "schemaVersion": "1.0",
  "manifestType": "theme",
  "catalogVersion": "0.4.0",
  "id": "coral-research",
  "version": "1.0.0",
  "displayName": "珊简·研究",
  "description": "面向证据综述、研究报告和数据解释，以温和珊红建立清晰层级、稳定阅读节奏和可复用的原创排版规则。",
  "status": "active",
  "category": "report",
  "tags": [
    "研究",
    "温和珊红",
    "多端候选"
  ],
  "legacyIds": [],
  "palette": {
    "accent": "#a3403d",
    "accentSoft": "#f4e8e8",
    "text": "#3b2928",
    "muted": "#8d8382",
    "border": "#edd9d8",
    "quote": "#f9f2f1",
    "heading": "#6f2524",
    "background": "#fdfafa"
  },
  "typography": {
    "defaultFamily": "serif",
    "fallbackStack": "\"Songti SC\",\"STSong\",\"Noto Serif CJK SC\",serif",
    "baseSize": 16,
    "lineHeight": 1.88,
    "headingWeight": 700,
    "bodyWeight": 400
  },
  "spacing": {
    "paragraph": 17,
    "section": 36,
    "pageX": 22,
    "pageY": 28
  },
  "features": {
    "autoNumbering": true,
    "keywordUnderline": false,
    "tableOfContents": true,
    "introduction": true,
    "signature": false,
    "spanLeaf": true,
    "cjkSpacing": true,
    "externalLinkFootnotes": true
  },
  "supportedComponentIds": [
    "lead",
    "quote",
    "notice",
    "steps",
    "metrics",
    "compare",
    "dialogue",
    "timeline",
    "divider",
    "cta",
    "outline",
    "abstract",
    "key-points",
    "contents",
    "introduction",
    "conclusion",
    "section-summary",
    "executive-summary",
    "premise",
    "definition",
    "context",
    "evidence",
    "source-note",
    "fact-check",
    "warning",
    "tip",
    "example",
    "case-study",
    "faq",
    "checklist",
    "decision-matrix",
    "pros-cons",
    "before-after",
    "process",
    "milestone",
    "schedule",
    "roadmap",
    "chronology",
    "interview",
    "debate",
    "testimonial",
    "figure",
    "image-gallery",
    "cover-card",
    "infographic",
    "video-card",
    "data-table",
    "formula",
    "code-snippet",
    "footnotes",
    "author-signature",
    "related-reading",
    "next-steps"
  ],
  "renderers": {
    "markdown": "creation.theme.coral-research.markdown.v1",
    "html": "creation.theme.coral-research.html.v1",
    "wechatRichText": "creation.theme.coral-research.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
    ],
    "wechatCertification": "candidate",
    "minRuntimeVersion": "0.1.2"
  },
  "source": {
    "policy": "yunspire_first_party",
    "authoredBy": "Yunspire",
    "repository": "https://github.com/Leo-sail/yunspire",
    "upstreamCodeCopied": false,
    "researchBoundary": "This theme is an original Yunspire project asset. External repositories informed capability research only; no upstream code, prompt, template, wording, or visual asset is included."
  },
  "license": {
    "scope": "yunspire_first_party_project_asset",
    "notice": "Original Yunspire theme manifest and rendering tokens; use is governed by the repository LICENSE.",
    "thirdPartyAssets": []
  }
}
