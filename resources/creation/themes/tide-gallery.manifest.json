{
  "schemaVersion": "1.0",
  "manifestType": "theme",
  "catalogVersion": "0.4.0",
  "id": "tide-gallery",
  "version": "1.0.0",
  "displayName": "潮汐·图集",
  "description": "面向图片主导的视觉故事和作品展示，以通透青蓝建立清晰层级、稳定阅读节奏和可复用的原创排版规则。",
  "status": "active",
  "category": "visual",
  "tags": [
    "图集",
    "通透青蓝",
    "多端候选"
  ],
  "legacyIds": [],
  "palette": {
    "accent": "#3496a1",
    "accentSoft": "#e7f2f4",
    "text": "#203438",
    "muted": "#7e898c",
    "border": "#d6eaec",
    "quote": "#f1f8f8",
    "heading": "#07505a",
    "background": "#fafcfd"
  },
  "typography": {
    "defaultFamily": "sans",
    "fallbackStack": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
    "baseSize": 15,
    "lineHeight": 1.7,
    "headingWeight": 600,
    "bodyWeight": 400
  },
  "spacing": {
    "paragraph": 14,
    "section": 44,
    "pageX": 14,
    "pageY": 22
  },
  "features": {
    "autoNumbering": false,
    "keywordUnderline": false,
    "tableOfContents": false,
    "introduction": true,
    "signature": false,
    "spanLeaf": true,
    "cjkSpacing": true,
    "externalLinkFootnotes": false
  },
  "supportedComponentIds": [
    "lead",
    "quote",
    "notice",
    "steps",
    "metrics",
    "compare",
    "dialogue",
    "timeline",
    "divider",
    "cta",
