  "renderers": {
    "markdown": "creation.theme.tide-gallery.markdown.v1",
    "html": "creation.theme.tide-gallery.html.v1",
    "wechatRichText": "creation.theme.tide-gallery.wechat.v1"
  },
  "compatibility": {
    "targets": [
      "markdown",
      "html",
      "wechatRichText"
