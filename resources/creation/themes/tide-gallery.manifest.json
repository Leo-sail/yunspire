    "key-points",
    "contents",
    "introduction",
    "conclusion",
    "section-summary",
    "executive-summary",
    "premise",
    "definition",
    "context",
    "evidence",
    "source-note",
    "fact-check",
    "warning",
    "tip",
    "example",
    "case-study",
    "faq",
    "checklist",
    "decision-matrix",
    "pros-cons",
    "before-after",
    "process",
    "milestone",
    "schedule",
    "roadmap",
    "chronology",
    "interview",
    "debate",
    "testimonial",
    "figure",
